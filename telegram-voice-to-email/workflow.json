{
  "name": "Telegram Voice Memo to Email (hardened)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "n-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "webhookId": "REPLACE_ME",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      },
      "notes": "Feuert bei jeder Nachricht - Filterung passiert in den naechsten beiden Nodes."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.message.chat.id.toString() }}",
              "rightValue": "={{ $env.ALLOWED_CHAT_ID }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n-auth",
      "name": "Absender pruefen",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "notes": "Ohne diesen Check kann jeder, der die Bot-ID kennt, Mails ueber deinen SMTP-Account ausloesen."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              },
              "leftValue": "={{ $json.message.voice }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n-isvoice",
      "name": "Ist Sprachnachricht?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        260
      ],
      "notes": "Bei Textnachrichten waere message.voice.file_id undefined und der Download wuerde fehlschlagen."
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.message.voice.file_id }}",
        "additionalFields": {}
      },
      "id": "n-download",
      "name": "Voice-Datei laden",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        200
      ],
      "webhookId": "REPLACE_ME",
      "onError": "continueErrorOutput",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "resource": "audio",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "inputType": "binary",
        "options": {}
      },
      "id": "n-stt",
      "name": "Transkription (Gemini)",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        880,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": false,
      "onError": "continueErrorOutput",
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_ME",
          "name": "Gemini API account"
        }
      },
      "notes": "alwaysOutputData bewusst false: sonst laeuft nach Fehlversuchen ein leeres Objekt weiter und der Agent erfindet eine Mail aus dem Nichts."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c3",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ ($json.content?.parts?.[0]?.text || '').trim().length }}",
              "rightValue": 10
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n-checktext",
      "name": "Transkript brauchbar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "notes": "Leeres oder Ein-Wort-Transkript => keine Mail, sondern Rueckmeldung an den Nutzer."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Transkription (Gemini)').item.json.content.parts[0].text }}",
        "options": {
          "systemMessage": "You are an email drafting assistant. You receive a voice memo transcription and must immediately write a complete, professional email based on it.\n\nRules:\n- Never ask clarifying questions.\n- Output ONLY the email, nothing else.\n- Line 1 MUST be the subject line in the exact form: Subject: <subject>\n- Line 2 MUST be empty.\n- Line 3 starts the body with the salutation (e.g. \"Dear ...\").\n- Do not repeat the subject inside the body.\n- If recipient or subject are not stated, infer them from context.\n- Write in the language of the transcription."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        1320,
        160
      ],
      "id": "n-agent",
      "name": "E-Mail formulieren",
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueErrorOutput",
      "notes": "Format ist eindeutig festgelegt, weil der Send-Node Zeile 1 als Betreff parst. Der urspruengliche Prompt widersprach sich hier selbst."
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1320,
        380
      ],
      "id": "n-model",
      "name": "Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_ME",
          "name": "Gemini API account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.MAIL_FROM }}",
        "toEmail": "={{ $env.MAIL_TO }}",
        "subject": "={{ $json.output.split('\\n')[0].replace(/^Subject:\\s*/i, '').trim() || 'Voice Memo' }}",
        "html": "={{ $json.output.split('\\n').slice(1).join('\\n').trim().replace(/\\n/g, '<br>') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1540,
        160
      ],
      "id": "n-send",
      "name": "E-Mail senden",
      "webhookId": "REPLACE_ME",
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "SMTP account"
        }
      },
      "notes": "Adressen aus Umgebungsvariablen, damit keine echten Mailadressen im Repo landen."
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Mail wurde versendet.\nBetreff: {{ $json.output ? $json.output.split('\\n')[0].replace(/^Subject:\\s*/i,'') : '' }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1760,
        160
      ],
      "id": "n-ok",
      "name": "Bestaetigung",
      "webhookId": "REPLACE_ME",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Verarbeitung fehlgeschlagen: {{ $json.error?.message || 'unbekannter Fehler' }}. Bitte Sprachnachricht erneut senden.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        460
      ],
      "id": "n-err",
      "name": "Fehlermeldung an Nutzer",
      "webhookId": "REPLACE_ME",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      },
      "notes": "Ohne diesen Pfad scheitert der Workflow still und der Nutzer wartet auf eine Mail, die nie kommt."
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Absender pruefen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Absender pruefen": {
      "main": [
        [
          {
            "node": "Ist Sprachnachricht?",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Ist Sprachnachricht?": {
